{
  "name": "tempnote",
  "description": "使わなくなったら勝手に消えるメモ帳です。",
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist/gas && vite build --mode gas && vite build --config vite.server.config.ts && node scripts/write-manifest.mjs",
    "typecheck": "tsc",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup": "node scripts/setup.mjs",
    "deploy": "node scripts/deploy.mjs",
    "favicon": "node scripts/make-favicon.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canpok1/tempnote.git"
  },
  "bugs": {
    "url": "https://github.com/canpok1/tempnote/issues"
  },
  "homepage": "https://github.com/canpok1/tempnote#readme",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@google/clasp": "^3.4.1",
    "@playwright/test": "^1.64.1",
    "@types/google-apps-script": "^2.0.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "private": true,
  "type": "module"
}
