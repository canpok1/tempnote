{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 120
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/client/**", "**/server/**"],
                    "message": "shared はフロントとサーバーの両方から使うため、どちらにも依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/client/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/server/**"],
                    "message": "画面はサーバーのコードを直接使わない。shared の型と transport を通す。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/application/**", "**/infrastructure/**", "**/entry/**", "**/client/**"],
                    "message": "ドメイン層は他の層に依存しない（shared だけ使える）。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/application/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/infrastructure/**", "**/entry/**", "**/client/**"],
                    "message": "アプリケーション層はインフラ層や入口に依存しない。必要なものは ports に定義する。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/infrastructure/gas/**", "src/server/entry/gas.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/local/**", "**/entry/**", "**/client/**"],
                    "message": "GAS 側はローカル用の実装を使わない（GAS のバンドルに入ってしまう）。インフラ層から入口へも依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/server/infrastructure/local/**", "src/server/entry/local.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/gas/**", "**/entry/**", "**/client/**"],
                    "message": "ローカル側は GAS 用の実装を使わない。インフラ層から入口へも依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
